STT_PROVIDER=whisperx_local
TTS_PROVIDER=kokoro
LLM_PROVIDER=deepseek

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

HOST=0.0.0.0
PORT=8000
DB_PATH=/app/data/speakwise.db
API_COST_ALERT_USD=30

# STT/TTS locales / software libre (default) - livianos, corren en CPU sin problema
WHISPER_MODEL=base

# Ollama queda disponible en el codigo (providers/llm_ollama.py) pero NO es el
# default: requiere correr un modelo de 7B localmente, que esta PC no soporta.
# Si en el futuro se usa en otra maquina: LLM_PROVIDER=ollama_qwen
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://ollama:11434
